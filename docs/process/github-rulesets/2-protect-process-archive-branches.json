{
    "name": "Protect process and archive branches",
    "target": "branch",
    "enforcement": "active",
    "bypass_actors": [],
    "conditions": {
        "ref_name": {
            "include": [
                "refs/heads/relay-channel",
                "refs/heads/supervisor-state",
                "refs/heads/decisions-tools",
                "refs/heads/archive/**",
                "refs/heads/codex/**"
            ],
            "exclude": []
        }
    },
    "rules": [
        {
            "type": "deletion"
        },
        {
            "type": "non_fast_forward"
        }
    ]
}
