{
  "input_sha": "d704adc006e6f988b25566e232853038d886e259",
  "units": "Image-plane working targets. M = manual measurement or resolved count; E = visual estimate, including categorical readings and occlusion. See README for landmarks.",
  "definitions": {
    "open_liner_h": {
      "kind": "ratio",
      "protocol": "Vertical dark band at midpoint of visible pigmented stroke / maximum clear eye opening height (H)."
    },
    "open_ink_span": {
      "kind": "ratio",
      "protocol": "Horizontal span of continuous pigmented upper margin / corner-to-corner eye width (W)."
    },
    "open_lash_count": {
      "kind": "count",
      "protocol": "Resolved separate tips on one upper lid. Ignore texture fibres and the liner ends."
    },
    "open_lash_positions": {
      "kind": "category",
      "protocol": "Root positions from temple (0) to nose (1), summarized by occupied quarters. Ignore liner ends."
    },
    "open_lash_length": {
      "kind": "ratio",
      "protocol": "Typical projecting tip length from ink edge / W. Zero for a smooth line."
    },
    "open_lash_curve": {
      "kind": "category",
      "protocol": "Direction and shape of resolved upper tips in the image plane."
    },
    "open_lower_lashes": {
      "kind": "category",
      "protocol": "Separate dark lower-lid projections visible at this image scale."
    },
    "open_colour": {
      "kind": "category",
      "protocol": "Visible lash-to-liner colour relation under pictured lighting."
    },
    "closed_ink_span": {
      "kind": "ratio",
      "protocol": "Projected dark continuous stroke width / closed corner separation. Use the longest continuous dark segment."
    },
    "closed_liner_h": {
      "kind": "ratio",
      "protocol": "Central dark thickness / expected neutral open H at this face scale. Infer neutral H by transferring the same eye in the neutral row using face scale. No central pigment = 0."
    },
    "closed_lash_count": {
      "kind": "count",
      "protocol": "Separate dark projections discernible on the blink stroke, excluding the stroke ends."
    },
    "closed_lash_positions": {
      "kind": "category",
      "protocol": "Root positions of separately visible blink tips, temple to nose."
    },
    "closed_lash_length": {
      "kind": "ratio",
      "protocol": "Typical separately visible blink tip length / closed corner separation."
    },
    "closed_curve": {
      "kind": "category",
      "protocol": "Shape of the visible dark line in a relaxed blink."
    },
    "closed_lower_lashes": {
      "kind": "category",
      "protocol": "Separate lower fringe distinguishable below closed seam."
    },
    "closed_colour": {
      "kind": "category",
      "protocol": "Colour of the visible blink stroke and separate tips, if resolved."
    },
    "ear_width": {
      "kind": "ratio",
      "protocol": "Visible front near pinna width / bare face width F; trace from outer rim to root (estimate root if covered)."
    },
    "ear_height": {
      "kind": "ratio",
      "protocol": "Visible vertical pinna extent / crown-to-chin Hh, excluding buns but including hairstyle crown."
    },
    "ear_top_eye": {
      "kind": "ratio",
      "protocol": "Ear top y minus iris-centre y / Hh (positive down)."
    },
    "ear_base_mouth": {
      "kind": "ratio",
      "protocol": "Lobule bottom y minus mouth centre y / Hh."
    },
    "ear_front_projection": {
      "kind": "ratio",
      "protocol": "Horizontal distance from cheek tangent at ear root to exposed outer rim / F. Zero when fully covered."
    },
    "ear_turn_projection": {
      "kind": "ratio",
      "protocol": "Near ear extension beyond local cheek contour at ear mid-height / projected face width. Ignore the hair contour."
    },
    "ear_outline": {
      "kind": "category",
      "protocol": "Visible near pinna outline on the turn."
    },
    "ear_fold": {
      "kind": "category",
      "protocol": "Interior shading/landmark on visible near ear, excluding glasses arm."
    },
    "ear_cover_front": {
      "kind": "category",
      "protocol": "Fraction of pinna hidden by hair; broad visual classes: rim only, partial, most, full."
    },
    "ear_cover_turn": {
      "kind": "category",
      "protocol": "Near pinna hair coverage on pictured oblique; far pinna may self-occlude."
    },
    "ear_cover_back": {
      "kind": "category",
      "protocol": "Hair overlap at rear, both sides combined."
    },
    "crown_above_skull": {
      "kind": "ratio",
      "protocol": "Highest main hair tip (exclude buns) above inferred smooth skull apex / Hh. Skull apex reconstructed by eye from temporal curvature."
    },
    "fringe_eye": {
      "kind": "ratio",
      "protocol": "Iris-centre y minus centreline fringe-tip y / Hh. Positive means fringe ends above eyes."
    },
    "forehead_covered": {
      "kind": "ratio",
      "protocol": "On facial midline, length of inferred skull-apex to brow interval covered by hair / full interval (cap at 1)."
    },
    "temple_sweep": {
      "kind": "ratio",
      "protocol": "Iris-centre y minus y of hair/skin edge at outer canthus x / Hh. Positive above eye."
    },
    "hair_cheek_width": {
      "kind": "ratio",
      "protocol": "Outermost hair-to-hair distance at y midway between pupils and mouth / F. Enter 0 if no hair crosses this line."
    },
    "hair_shoulder_width": {
      "kind": "ratio",
      "protocol": "Hair-to-hair span at shoulder seam level / F. Enter 0 if hair ends above this line."
    },
    "lock_count": {
      "kind": "count",
      "protocol": "Distinct major visible terminals across rear lower silhouette (one tip per separated major clump; ignore fibres and internal ridges)."
    },
    "lock_spacing": {
      "kind": "ratio",
      "protocol": "Typical horizontal spacing between adjacent tips / rear hair silhouette width at its widest, estimated across central group."
    },
    "lock_end": {
      "kind": "category",
      "protocol": "Shape of major rear terminals and flow into them."
    },
    "bun_count": {
      "kind": "count",
      "protocol": "Count distinct tied-up bun masses (lobes of auburn single knot count together)."
    },
    "bun_width": {
      "kind": "ratio",
      "protocol": "Outer width of one bun / F (auburn whole knot, white image-left bun). Zero for absent."
    },
    "bun_x": {
      "kind": "ratio",
      "protocol": "Signed horizontal bun centre from facial midline / F, right positive. For twins use image-left. Zero if absent."
    },
    "bun_y": {
      "kind": "ratio",
      "protocol": "Vertical bun centre above iris-centre line / Hh. Zero if absent."
    },
    "accessory": {
      "kind": "category",
      "protocol": "Hair accessory identity and side in front view (image coordinates)."
    },
    "accessory_x": {
      "kind": "ratio",
      "protocol": "Pink flower or blue bow centre x minus facial midline / F. Zero if absent."
    },
    "accessory_y": {
      "kind": "ratio",
      "protocol": "Eye line minus accessory centre y / Hh. Zero if absent."
    },
    "ear_cover_profile": {
      "kind": "category",
      "protocol": "Near pinna hair coverage in lateral view."
    }
  },
