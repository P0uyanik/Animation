[32m+[m[32m// Engine path tracer tests (built only with PLUSH_BUILD_RENDERER=ON). Moved verbatim from test_engine.cpp (T-085).[m
[32m+[m[32m#include <doctest/doctest.h>[m
[1;36m+[m
[32m+[m[32m#include <memory>[m
[1;36m+[m
[32m+[m[32m#include "render/bsdf.h"[m
[32m+[m[32m#include "render/image.h"[m
