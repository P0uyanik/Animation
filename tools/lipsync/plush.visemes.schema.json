{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "const": "plush.visemes/1"
    },
    "fps": {
      "enum": [
        24,
        30
      ]
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "source": {
      "enum": [
        "fallback-audio",
        "fallback-text",
        "rhubarb-1.13.0"
      ]
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {
          "enum": [
            "rest",
            "AI",
            "E",
            "O",
            "U",
            "FV",
            "MBP",
            "L",
            "WQ",
            "C"
          ]
        },
        "additionalProperties": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  },
  "required": [
    "format",
    "fps",
    "duration",
    "source",
    "frames"
  ],
  "additionalProperties": false
}
