{
 "format": "plush.verb",
 "version": 1,
 "id": "pass",
 "description": "Hand a held prop to another character (design docs/architecture/INTERACTION_AFFORDANCES.md 4.4): giver offers, receiver looks, reaches and grasps, both hold, giver releases, both settle. Lowers to the handover primitive; fallbacks are today's handover defaults (design 3.3). With \"react\": true the receiver's look is a partner_acts reaction (design 4.5).",
 "requires": {"hand_state": "holding", "prop_state": "held", "affordances": "optional"},
 "phases": [
  {"name": "look", "who": "receiver", "beat": "reaction_delay", "fallback_f": 4, "curve": "linear", "drives": ["gaze"], "target": "prop",
   "events": ["reaction:partner_acts?"]},
  {"name": "manipulate", "part": "offer", "who": "giver", "curve": "ease_in_out", "drives": ["ik", "orient"]},
  {"name": "approach", "who": "receiver", "beat": "reach", "share": "approach", "fallback_f": 14, "curve": "ease_in_out",
   "drives": ["ik", "orient", "hand_shape:open"], "constraints": ["reachable"]},
  {"name": "contact", "who": "receiver", "beat": "reach", "share": "contact", "curve": "slow_in",
   "drives": ["ik", "hand_shape:closed", "grasp_weight"], "constraints": ["palm_on_socket<=0.5mm", "reachable", "outside_body"],
   "events": ["parent:receiver"]},
  {"name": "manipulate", "part": "shared", "who": "both", "beat": "shared_hold", "fallback_f": 4, "curve": "hold", "drives": ["shared"]},
  {"name": "release", "who": "giver", "beat": "release", "fallback_f": 12, "curve": "slow_out", "drives": ["hand_shape:open", "ik"]},
  {"name": "settle", "who": "both", "beat": "settle", "fallback_f": 12, "curve": "slow_out", "drives": ["gaze", "hold_pose"], "optional": true}
 ],
 "lowers_to": "handover"
}
